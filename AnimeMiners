local function makeToggle(label, sub, order, accent, default, callback)
    local Row = Instance.new("Frame")
    Row.Size             = UDim2.new(1, 0, 0, sub and 46 or 40)
    Row.BackgroundColor3 = COL.panel
    Row.BorderSizePixel  = 0
    Row.LayoutOrder      = order
    Row.Parent           = Body
    corner(Row, 9)

    local Lbl = Instance.new("TextLabel")
    Lbl.Size                   = UDim2.new(1, -66, 0, 16)
    Lbl.Position               = UDim2.fromOffset(12, sub and 7 or 12)
    Lbl.BackgroundTransparency = 1
    Lbl.Text                   = label
    Lbl.TextColor3             = COL.text
    Lbl.TextSize               = 13
    Lbl.Font                   = Enum.Font.GothamMedium
    Lbl.TextXAlignment         = Enum.TextXAlignment.Left
    Lbl.Parent                 = Row

    if sub then
        local S = Instance.new("TextLabel")
        S.Size                   = UDim2.new(1, -66, 0, 13)
        S.Position               = UDim2.fromOffset(12, 24)
        S.BackgroundTransparency = 1
        S.Text                   = sub
        S.TextColor3             = COL.dim
        S.TextSize               = 10.5
        S.Font                   = Enum.Font.Gotham
        S.TextXAlignment         = Enum.TextXAlignment.Left
        S.Parent                 = Row
    end

    local Track = Instance.new("TextButton")
    Track.Size             = UDim2.fromOffset(42, 22)
    Track.Position         = UDim2.new(1, -54, 0.5, -11)
    Track.BackgroundColor3 = COL.off
    Track.BorderSizePixel  = 0
    Track.Text             = ""
    Track.AutoButtonColor  = false
    Track.Parent           = Row
    corner(Track, 11)

    local Knob = Instance.new("Frame")
    Knob.Size             = UDim2.fromOffset(16, 16)
    Knob.Position         = UDim2.fromOffset(3, 3)
    Knob.BackgroundColor3 = Color3.fromRGB(170, 170, 188)
    Knob.BorderSizePixel  = 0
    Knob.Parent           = Track
    corner(Knob, 8)

    local on = false
    local function apply(v, silent)
        on = v
        TweenService:Create(Track, TweenInfo.new(0.16),
            { BackgroundColor3 = on and accent or COL.off }):Play()
        TweenService:Create(Knob, TweenInfo.new(0.16, Enum.EasingStyle.Quad), {
            Position         = on and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3),
            BackgroundColor3 = on and Color3.new(1, 1, 1) or Color3.fromRGB(170, 170, 188),
        }):Play()
        if not silent then callback(on) end
    end

    Track.MouseButton1Click:Connect(function() apply(not on) end)
    if default then apply(true, true) end
    return apply
end


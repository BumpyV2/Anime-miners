local Remotes        = ReplicatedStorage:WaitForChild("Remotes")
local GamestateEvent = Remotes:WaitForChild("GamestateEvent")
local GameState      = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameState"))
local MineConfig     = require(ReplicatedStorage.Modules:WaitForChild("MineConfig"))
local Items          = require(ReplicatedStorage.Modules:WaitForChild("Items"))

local SELL_RANGE     = 12      -- server's own prompt range is 14
local SELL_OFFSET    = 4       -- how far in front of the buyer we land

local function getData()
    local ok, d = pcall(GameState.GetData, lp)
    if ok and type(d) == "table" then return d end
    return nil
end

local function getMine()
    local d = getData()
    return d and d.MineGame or nil
end

local function getRoot()
    local c = lp.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

--- The Item Buyer's torso, which carries the SellPrompt.
local function getBuyerPart()
    local stand = workspace:FindFirstChild("SellStand")
    if stand then
        for _, v in ipairs(stand:GetDescendants()) do
            if v:IsA("ProximityPrompt") and v.Name == "SellPrompt" then
                if v.Parent and v.Parent:IsA("BasePart") then return v.Parent end
            end
        end
    end
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.Name == "SellPrompt" then
            if v.Parent and v.Parent:IsA("BasePart") then return v.Parent end
        end
    end
    return nil
end


--  LOOPS
-- ════════════════════════════════════════════════════════════════
task.spawn(function()
    while true do
        if State.AutoLoot then
            local ok, fired, stacks = pcall(takeChest)
            if ok and fired then
                State.Chests = State.Chests + 1
                setStatus(string.format("took %d stack(s) from chest", stacks), COL.loot)
            end
        end
        task.wait(State.LootInterval)
    end
end)

task.spawn(function()
    while true do
        if State.AutoSell then
            local before = (getData() or {}).Money or 0
            local ok, fired, n, moved = pcall(sellOres)
            if ok and fired then
                task.wait(0.5)
                local after = (getData() or {}).Money or 0
                local gained = after - before
                if gained > 0 then
                    State.Sells  = State.Sells + 1
                    State.Earned = State.Earned + gained
                    setStatus(string.format("sold %d ore type(s)  +$%s%s",
                        n, abbreviate(gained), moved and "  (travelled)" or ""), COL.sell)
                else
                    setStatus("sell refused — are you at the Item Buyer?", COL.travel)
                end
            elseif ok and n and n > 0 and not State.Travel then
                setStatus("ores waiting — enable Travel to Buyer", COL.travel)
            end
        end
        task.wait(State.SellInterval)
    end
end)

task.spawn(function()
    while true do
        local fast = false
        if State.AutoBuy then
            local ok, bought, c, refused = pcall(buyOne)
            if ok and bought then
                fast = true   -- chain purchases while money lasts
                setStatus(string.format("bought %s  -$%s", c.label, abbreviate(c.cost)), COL.buy)
            elseif ok and refused then
                setStatus(string.format("%s refused, retry in %ds", c.label, REFUSE_COOLDOWN), COL.travel)
            end
        end
        task.wait(fast and 0.3 or State.BuyInterval)
    end
end)

task.spawn(function()
    while true do
        refreshStats()
        task.wait(0.5)
    end
end)


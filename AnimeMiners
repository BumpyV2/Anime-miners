-- AUTO LOOT CHEST
-- ═══════════════════════════════════════════
local function findChestPrompt()
    -- Check the main MinePlot chest
    for _, plot in ipairs(workspace.MineWorld.Plots:GetChildren()) do
        local chest = plot:FindFirstChild("Chest")
        if chest then
            local pp = chest:FindFirstChild("ChestPrompt")
            if pp and pp:IsA("ProximityPrompt") then
                return pp, chest
            end
        end
    end
    -- Also scan workspace Loot folder for spawned chests
    local lootFolder = workspace.MineWorld.Plots:FindFirstChild("MinePlot1")
    if lootFolder then
        local loot = lootFolder:FindFirstChild("Loot")
        if loot then
            for _, item in ipairs(loot:GetChildren()) do
                local pp = item:FindFirstChildWhichIsA("ProximityPrompt")
                if pp then return pp, item end
            end
        end
    end
    return nil, nil
end

local function triggerProximityPrompt(pp)
    -- Fire the prompt via the ProximityPromptService
    local pps = game:GetService("ProximityPromptService")
    -- We use the internal trigger approach
    local ok, err = pcall(function()
        fireproximityprompt(pp)
    end)
    if not ok then
        -- Fallback: use the prompt's TriggerEnded event path
        local ok2 = pcall(function()
            pp.Triggered:Fire(lp)
        end)
    end
end

local function tryLootChest()
    local pp, chest = findChestPrompt()
    if not pp then return false end

    -- Check we're close enough (MaxActivationDistance)
    local maxDist = pp.MaxActivationDistance
    local chestPos
    if chest then
        local ok, piv = pcall(function() return chest:GetPivot().Position end)
        if ok then chestPos = piv end
    end
    if not chestPos then
        local base = chest and (chest:FindFirstChild("ChestBase") or chest:FindFirstChildWhichIsA("BasePart"))
        if base then chestPos = base.Position end
    end

    if chestPos and rootPart then
        local dist = (rootPart.Position - chestPos).Magnitude
        if dist > maxDist then
            setStatus("Moving to chest...")
            -- Teleport character to chest
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = CFrame.new(chestPos + Vector3.new(0, 3, 0))
                task.wait(0.3)
            end
        end
    end

    -- Trigger the prompt
    local ok = pcall(fireproximityprompt, pp)
    if ok then
        setStatus("Looting chest...")
        return true
    end
    return false
end

-- Auto Loot loop
local autoLootThread = nil
local function startAutoLoot()
    if autoLootThread then return end
    autoLootThread = task.spawn(function()
        while State.AutoLootChest do
            local success = tryLootChest()
            if not success then
                setStatus("No chest found, waiting...")
            end

            -- Also handle ChestFrame auto-take if it appears
            if ChestFrame.Visible then
                local takeBtn = ChestFrame:FindFirstChild("Content") and ChestFrame.Content:FindFirstChild("Actions") and ChestFrame.Content.Actions:FindFirstChild("TakeButton")
                if takeBtn then
                    task.wait(0.3)
                    takeBtn:FireButton1Click()
                    setStatus("Took chest items!")
                end
            end

            task.wait(2)
        end
        autoLootThread = nil
    end)
end

local function stopAutoLoot()
    State.AutoLootChest = false
    if autoLootThread then
        task.cancel(autoLootThread)
        autoLootThread = nil
    end
    setStatus("Auto Loot stopped")
end


task.spawn(function()
    while true do
        if State.AutoLoot then
            local ok, fired, stacks = pcall(takeChest)
            if ok and fired then
                State.Chests = State.Chests + 1
                setStatus(string.format("took %d stack(s) from chest", stacks), COL.loot)

                -- New loot may contain better units: let the game re-pick.
                -- Same call as the inventory's Equip Best button.
                if State.AutoEquip and os.clock() - State.LastEquip >= 5 then
                    task.wait(1)   -- let the loot land in the inventory first
                    GamestateEvent:FireServer("MineEquipBest")
                    State.LastEquip = os.clock()
                    setStatus(string.format("took %d stack(s), equipped best", stacks), COL.loot)
                end
            end
        end
        task.wait(State.LootInterval)
    end
end)

task.spawn(function()
    while true do
        if State.AutoSell then
            local before = (getData() or {}).Money or 0
            local ok, fired, n, moved = pcall(sellOres)
            if ok and fired then
                task.wait(0.5)
                local after = (getData() or {}).Money or 0
                local gained = after - before
                if gained > 0 then
                    State.Sells  = State.Sells + 1
                    State.Earned = State.Earned + gained
                    setStatus(string.format("sold %d ore type(s)  +$%s%s",
                        n, abbreviate(gained), moved and "  (travelled)" or ""), COL.sell)
                else
                    setStatus("sell refused — are you at the Item Buyer?", COL.travel)
                end
            elseif ok and n and n > 0 and not State.Travel then
                setStatus("ores waiting — enable Travel to Buyer", COL.travel)
            end
        end
        task.wait(State.SellInterval)
    end
end)

task.spawn(function()
    while true do
        local fast = false
        if State.AutoBuy then
            local ok, bought, c, refused, pushing = pcall(buyOne)
            if ok and bought then
                fast = true   -- chain purchases while money lasts
                if pushing and State.PowerGoal then
                    setStatus(string.format("power %s/%s: %s", abbreviate(teamPower()),
                        abbreviate(State.PowerGoal), c.label), COL.buy)
                else
                    setStatus(string.format("bought %s  -$%s", c.label, abbreviate(c.cost)), COL.buy)
                end
            elseif ok and refused then
                setStatus(string.format("%s refused, retry in %ds", c.label, REFUSE_COOLDOWN), COL.travel)
            end
        end
        task.wait(fast and 0.3 or State.BuyInterval)
    end
end)

task.spawn(function()
    local lastNote
    while true do
        if State.AutoPickaxe then
            local ok, result, best, have, holders = pcall(buyBestPickaxe)
            if ok and best then
                local short = tostring(best.Name):gsub(" Pickaxe", "")
                local msg, col
                if result == "bought" then
                    msg, col = string.format("bought %s pickaxe (%d/%d miners)", short, have, holders), COL.buy
                elseif result == "done" then
                    msg, col = string.format("all %d miners have %s", holders, short), COL.dim
                elseif result == "soldout" then
                    msg, col = string.format("%s sold out, waiting for restock", short), COL.dim
                elseif result == "poor" then
                    msg, col = string.format("saving for %s ($%s)", short, abbreviate(best.Cost)), COL.dim
                elseif result == "refused" then
                    msg, col = string.format("%s buy refused, retry in 30s", short), COL.travel
                end
                if msg and (result == "bought" or msg ~= lastNote) then
                    setStatus(msg, col)
                    lastNote = msg
                end
            end
            task.wait((ok and result == "bought") and 1 or 3)
        else
            task.wait(3)
        end
    end
end)

task.spawn(function()
    while true do
        refreshStats()
        task.wait(0.5)
    end
end)


local function refreshStats()
    local mine = getMine()
    StatChest.Text = string.format("Chests taken  %d     in chest: %d",
        State.Chests, mine and countKeys(mine.Chest) or 0)
    StatSell.Text  = string.format("Sells         %d     ore types: %d",
        State.Sells, mine and countKeys(mine.Ores) or 0)
    StatCash.Text  = string.format("Earned        $%s", abbreviate(State.Earned))
    StatBuy.Text   = string.format("Upgrades      %d     spent: $%s", State.Bought, abbreviate(State.Spent))

    local pickText = "Pickaxes      -"
    if mine then
        local ok, best = pcall(bestPickaxe, mine)
        if ok and best then
            local _, have, holders = pickaxesNeeded(mine, best.Name)
            pickText = string.format("Pickaxes      %d     %s %d/%d",
                State.PickaxesBought, tostring(best.Name):gsub(" Pickaxe", ""), have, holders)
        end
    end
    StatPick.Text = pickText

    if State.PowerGoal and teamPower() < State.PowerGoal then
        StatPower.Text = string.format("Team power    %s  next gate %s",
            abbreviate(teamPower()), abbreviate(State.PowerGoal))
    else
        StatPower.Text = string.format("Team power    %s", abbreviate(teamPower()))
    end
end


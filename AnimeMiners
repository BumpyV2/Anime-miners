-- AUTO SELL
-- ═══════════════════════════════════════════
local function findSellNPC()
    -- The GingerbreadKeeper / SellStand
    local sellStand = workspace:FindFirstChild("SellStand")
    if sellStand then
        for _, v in ipairs(sellStand:GetDescendants()) do
            if v:IsA("ProximityPrompt") and v.Name == "SellPrompt" then
                local npcPart = v.Parent
                while npcPart and not npcPart:IsA("BasePart") do
                    npcPart = npcPart.Parent
                end
                -- Use UpperTorso or any part position
                local torso = sellStand:FindFirstChild("UpperTorso", true) or npcPart
                return v, torso and torso.Position
            end
        end
    end
    -- Fallback: search workspace
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.Name == "SellPrompt" then
            local part = v.Parent
            return v, part and part:IsA("BasePart") and part.Position
        end
    end
    return nil, nil
end

local function doSell()
    -- Method 1: fire SellItems remote directly (most reliable)
    -- The game fires SellItems with no arguments (server handles which items are queued)
    local ok = pcall(function()
        SellItems:FireServer()
    end)
    if ok then
        setStatus("Sold items!")
        return true
    end

    -- Method 2: open SellFrame UI and click SelectAll + Sell
    if SellFrame.Visible then
        local content = SellFrame:FindFirstChild("Content")
        if content then
            local selectAll = content:FindFirstChild("SelectAllButton")
            local sellBtn = content:FindFirstChild("SellButton")
            if selectAll then selectAll:FireButton1Click() task.wait(0.2) end
            if sellBtn then sellBtn:FireButton1Click() setStatus("Sold via UI!") return true end
        end
    end

    return false
end

local function tryAutoSell()
    local sellPP, sellPos = findSellNPC()
    if not sellPP then
        setStatus("Sell NPC not found")
        return false
    end

    -- Teleport to NPC if too far
    if sellPos and rootPart then
        local dist = (rootPart.Position - sellPos).Magnitude
        if dist > sellPP.MaxActivationDistance then
            setStatus("Moving to sell NPC...")
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = CFrame.new(sellPos + Vector3.new(0, 3, 4))
                task.wait(0.4)
            end
        end
    end

    -- Trigger sell prompt to open the UI
    pcall(fireproximityprompt, sellPP)
    task.wait(0.5)

    -- Now click SelectAll + Sell in the SellFrame
    if SellFrame.Visible then
        local content = SellFrame:FindFirstChild("Content")
        if content then
            local selectAll = content:FindFirstChild("SelectAllButton")
            local sellBtn = content:FindFirstChild("SellButton")
            if selectAll then
                selectAll:FireButton1Click()
                task.wait(0.25)
            end
            if sellBtn then
                sellBtn:FireButton1Click()
                setStatus("All items sold!")
                -- Close frame
                local close = SellFrame:FindFirstChild("Close")
                if close then close:FireButton1Click() end
                return true
            end
        end
    end

    -- Fallback: fire remote directly
    return doSell()
end

local autoSellThread = nil
local function startAutoSell()
    if autoSellThread then return end
    autoSellThread = task.spawn(function()
        while State.AutoSell do
            local ok = tryAutoSell()
            if not ok then
                -- Try direct remote as fallback
                pcall(function() SellItems:FireServer() end)
                setStatus("Sell attempt sent")
            end
            task.wait(5)
        end
        autoSellThread = nil
    end)
end

local function stopAutoSell()
    State.AutoSell = false
    if autoSellThread then
        task.cancel(autoSellThread)
        autoSellThread = nil
    end
    setStatus("Auto Sell stopped")
end

-- Watch SellFrame visibility: if it opens and AutoSell is on, auto-click SelectAll + Sell
SellFrame:GetPropertyChangedSignal("Visible"):Connect(function()
    if SellFrame.Visible and State.AutoSell then
        task.wait(0.3)
        local content = SellFrame:FindFirstChild("Content")
        if content then
            local selectAll = content:FindFirstChild("SelectAllButton")
            local sellBtn = content:FindFirstChild("SellButton")
            if selectAll then selectAll:FireButton1Click() task.wait(0.2) end
            if sellBtn then
                sellBtn:FireButton1Click()
                setStatus("Auto-sold all items!")
                task.wait(0.3)
                local close = SellFrame:FindFirstChild("Close")
                if close then close:FireButton1Click() end
            end
        end
    end
end)


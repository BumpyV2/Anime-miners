end

local function refreshStats()
    local mine = getMine()
    local pending = mine and countKeys(mine.Chest) or 0
    local ores    = mine and countKeys(mine.Ores) or 0

    StatChest.Text = string.format("Chests taken   %d    (in chest: %d)", State.ChestsLooted, pending)
    StatSold.Text  = string.format("Sell batches   %d    (ore types: %d)", State.OresSold, ores)
    StatCash.Text  = string.format("Earned         $%s", abbreviate(State.MoneyEarned))
end

-- ════════════════════════════════════════════════════════════════
--  LOOPS
-- ════════════════════════════════════════════════════════════════
local function trackEarnings(before)
    local d = getData()
    if not d then return end
    local gained = (d.Money or 0) - before
    if gained > 0 then State.MoneyEarned = State.MoneyEarned + gained end
end

task.spawn(function()
    while true do
        if State.AutoLoot then
            local ok, fired, count = pcall(takeChest)
            if ok and fired then
                State.ChestsLooted = State.ChestsLooted + 1
                setStatus(string.format("took %d stack(s) from chest", count), true)
            end
        end
        task.wait(State.LootInterval)
    end
end)

task.spawn(function()
    while true do
        if State.AutoSell then
            local d = getData()
            local before = d and d.Money or 0
            local ok, fired, n = pcall(sellOres)
            if ok and fired then
                State.OresSold = State.OresSold + 1
                task.wait(0.6)
                trackEarnings(before)
                setStatus(string.format("sold %d ore type(s)", n), true)
            end
        end
        task.wait(State.SellInterval)
    end
end)

task.spawn(function()
    while true do
        refreshStats()
        task.wait(0.5)
    end
end)


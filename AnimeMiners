--- Empty the loot chest. Remote-only, works anywhere.
local function takeChest()
    local mine = getMine()
    if not mine or type(mine.Chest) ~= "table" then return false, 0 end
    local stacks = countKeys(mine.Chest)
    if stacks == 0 then return false, 0 end
    GamestateEvent:FireServer("MineTakeChest")
    return true, stacks
end

--- Build the sell payload: ore names only, so characters, pickaxes
--- and gear are never included.
local function oreKeys()
    local mine = getMine()
    if not mine or type(mine.Ores) ~= "table" then return {} end
    local keys = {}
    for name, amount in pairs(mine.Ores) do
        if (tonumber(amount) or 0) > 0 then table.insert(keys, name) end
    end
    table.sort(keys)
    return keys
end

--- Sell every ore. Returns fired, numKeys, moved.
local function sellOres()
    local keys = oreKeys()
    if #keys == 0 then return false, 0, false end

    local root  = getRoot()
    local buyer = getBuyerPart()
    if not root or not buyer then return false, 0, false end

    local inRange = (root.Position - buyer.Position).Magnitude <= SELL_RANGE

    if inRange then
        GamestateEvent:FireServer("MineSellItems", keys)
        return true, #keys, false
    end

    if not State.Travel then return false, #keys, false end
    if State.Busy then return false, #keys, false end

    -- Hop over, sell, hop back.
    State.Busy = true
    local saved = root.CFrame
    local okTrip = pcall(function()
        root.CFrame = CFrame.new(buyer.Position) * CFrame.new(0, 0, SELL_OFFSET)
        task.wait(0.75)
        GamestateEvent:FireServer("MineSellItems", keys)
        task.wait(1.0)
    end)
    -- Always try to put the character back, even if the sell errored.
    local root2 = getRoot()
    if root2 and saved then pcall(function() root2.CFrame = saved end) end
    State.Busy = false

    return okTrip, #keys, true
end

-- ── Auto Buy Upgrades ───────────────────────────────────────────
-- The in-game "Upgrades" button opens the skill tree. Two kinds of
-- purchase live there, both verified against the client's own buy path:
--   core  : GamestateEvent:FireServer(CoreUpgradeById[id].Event)
--           ("MineUpgradeTap", "MineBuyMinerSlot") — no arguments
--   skills: GamestateEvent:FireServer("MineBuySkill", zone, family, nodeId)
-- Costs come from the game's own config so we only fire when affordable.

local CORE_LABEL = { Tap = "Tap damage", Slots = "Miner slot" }
local REFUSE_COOLDOWN = 60

local function coreFamilyOpen(mine, family)
    for _, node in pairs(MineConfig.CoreNodeById) do
        if node.Family == family then
            local ok1, open  = pcall(MineConfig.IsCoreNodeOpen, mine, node)
            local ok2, maxed = pcall(MineConfig.IsCoreNodeMaxed, mine, node)
            if ok1 and ok2 and open and not maxed then return true end
        end
    end
    return false
end

-- ── Crew (miner) upgrades ───────────────────────────────────────
--   GamestateEvent:FireServer("MineUpgradeCharacter", slot, kind)
--   kind = "Damage" | "Speed" | "MineSpeed"   (slot = "M1".."M8")
-- Only Damage raises team power (the MinePower attribute), which is what
-- gates Density / Colossus skill nodes. Verified live: Speed and
-- MineSpeed leave MinePower untouched.
local CREW_KINDS = {
    { kind = "Damage",    field = "CharLevel",          cost = "GetCharacterUpgradeCost",
      label = "dmg" },
    { kind = "Speed",     field = "CharSpeedLevel",     cost = "GetCharacterSpeedUpgradeCost",
      label = "speed",  cap = "CharSpeedMaxLevel" },
    { kind = "MineSpeed", field = "CharMineSpeedLevel", cost = "GetCharacterMineSpeedUpgradeCost",
      label = "mining", cap = "CharMineSpeedMaxLevel" },
}

local function teamPower()
    return tonumber(lp:GetAttribute("MinePower")) or 0
end

local function crewCandidates(mine, out, now)
    for slot, h in pairs(mine.Holders or {}) do
        if type(h) == "table" and h.CharName and h.CharName ~= "" then
            local okI, item = pcall(Items.GetItemData, h.CharName)
            if okI and type(item) == "table" then
                local okB, base = pcall(MineConfig.GetHolderBaseDamage, h, item)
                base = (okB and tonumber(base)) or 0
                for _, k in ipairs(CREW_KINDS) do
                    local key   = "crew:" .. slot .. ":" .. k.kind
                    local level = tonumber(h[k.field]) or 1
                    local cap
                    if k.cap then
                        cap = tonumber(MineConfig[k.cap])
                    else
                        local okC, c = pcall(MineConfig.GetCharLevelCap, item)
                        cap = okC and tonumber(c) or nil
                    end
                    if (State.Cooldown[key] or 0) <= now and (not cap or level < cap) then
                        local okP, cost = pcall(MineConfig[k.cost], level, item)
                        if okP and type(cost) == "number" and cost > 0 then
                            local field, kind = k.field, k.kind
                            table.insert(out, {
                                key   = key,
                                cost  = cost,
                                label = string.format("%s %s %s L%d", slot, tostring(h.CharName), k.label, level + 1),
                                -- each Damage level adds +0.25x of base damage
                                power = (kind == "Damage") and base * 0.25 or nil,
                                fire  = function()
                                    GamestateEvent:FireServer("MineUpgradeCharacter", slot, kind)
                                end,
                                level = function(m)
                                    local hh = m.Holders and m.Holders[slot]
                                    return hh and tonumber(hh[field]) or 0
                                end,
                            })
                        end
                    end
                end
            end
        end
    end
end

--- Every upgrade that is unlocked, not maxed and not cooling down,
--- cheapest first. Skill nodes gated behind team power we don't have yet
--- are held back; the smallest such gate is returned as the power goal.
local function buyCandidates(mine)
    local out, now = {}, os.clock()
    local power, powerGoal = teamPower(), nil

    for id, upg in pairs(MineConfig.CoreUpgradeById) do
        local key   = "core:" .. id
        local level = tonumber(mine[upg.Field]) or 0
        if (State.Cooldown[key] or 0) <= now
            and (not upg.Max or level < upg.Max)
            and coreFamilyOpen(mine, id) then
            local ok, cost = pcall(upg.Cost, level)
            if ok and type(cost) == "number" then
                table.insert(out, {
                    key   = key,
                    cost  = cost,
                    label = CORE_LABEL[id] or id,
                    fire  = function() GamestateEvent:FireServer(upg.Event) end,
                    level = function(m) return tonumber(m[upg.Field]) or 0 end,
                })
            end
        end
    end

    for zone, unlocked in pairs(mine.UnlockedZones or {}) do
        local nodes = unlocked and MineConfig.ZoneSkillNodes[zone]
        if nodes then
            local skills = (mine.Skills and mine.Skills[zone]) or {}
            for _, node in ipairs(nodes) do
                local key = "skill:" .. zone .. ":" .. node.Id
                if (State.Cooldown[key] or 0) <= now then
                    local ok1, open  = pcall(MineConfig.IsSkillNodeOpen, skills, node)
                    local ok2, maxed = pcall(MineConfig.IsSkillNodeMaxed, skills, node)
                    if ok1 and ok2 and open and not maxed then
                        local family = node.Family
                        local lvl    = tonumber(skills[family]) or 0
                        local ok3, cost = pcall(MineConfig.GetSkillCost, zone, lvl, family)
                        -- Team-power gate for the level this purchase reaches
                        -- (only NodeLevel / BigNode families have one).
                        local okR, req = pcall(MineConfig.GetSkillPowerReq, zone, family, lvl + 1)
                        local gated = okR and type(req) == "number" and power < req
                        if gated then
                            if not powerGoal or req < powerGoal then powerGoal = req end
                        elseif ok3 and type(cost) == "number" then
                            table.insert(out, {
                                key   = key,
                                cost  = cost,
                                label = zone .. " " .. tostring(node.Name or node.Id),
                                fire  = function()
                                    GamestateEvent:FireServer("MineBuySkill", zone, family, node.Id)
                                end,
                                level = function(m)
                                    local s = m.Skills and m.Skills[zone]
                                    return s and tonumber(s[family]) or 0
                                end,
                            })
                        end
                    end
                end
            end
        end
    end

    if State.UpgradeMiners then crewCandidates(mine, out, now) end

    table.sort(out, function(a, b) return a.cost < b.cost end)
    return out, powerGoal
end

-- ── Auto Buy Best Pickaxe ───────────────────────────────────────
-- Every miner pad (MineGame.Holders) carries one pickaxe. The server
-- hands a newly bought pickaxe to the weakest miner a few seconds later.
--   buy  : GamestateEvent:FireServer("MineBuyPickaxe", indexInMineConfig.Pickaxes)
--          works from anywhere, no need to stand at the shop
--   stock: GameState.Stocks.Pickaxes.CurrentStock[name].Stock, minus this
--          player's buys this cycle in data.StockPurchases.Pickaxes

--- Best pickaxe the player's unlocked zones allow, with its list index.
local function bestPickaxe(mine)
    local unlocked = mine.UnlockedZones or {}
    local stockTbl = GameState.Stocks and GameState.Stocks.Pickaxes
                     and GameState.Stocks.Pickaxes.CurrentStock or {}
    local best, bestIdx
    for i, p in ipairs(MineConfig.Pickaxes) do
        local okO, obtainable = pcall(MineConfig.PickaxeObtainable, p)
        if okO and obtainable
            and unlocked[p.ZoneReq]
            and (tonumber(p.Cost) or 0) > 0       -- skip free/event pickaxes
            and stockTbl[p.Name] ~= nil           -- only shop pickaxes
            and (not best or (p.Multiplier or 0) > (best.Multiplier or 0)) then
            best, bestIdx = p, i
        end
    end
    return best, bestIdx
end

local function pickaxeStockLeft(d, name)
    local S = GameState.Stocks and GameState.Stocks.Pickaxes
    if not S or not S.CurrentStock or not S.CurrentStock[name] then return 0 end
    local stock = tonumber(S.CurrentStock[name].Stock) or 0
    local mine = d.StockPurchases and d.StockPurchases.Pickaxes
    local boughtThisCycle = 0
    if mine and mine.Purchases and mine.Timestamp == S.BeginningTimestamp then
        boughtThisCycle = tonumber(mine.Purchases[name]) or 0
    end
    return math.max(0, stock - boughtThisCycle)
end

--- How many miners still lack `name`, minus spares already owned
--- (those get auto-assigned), so we never overbuy.
local function pickaxesNeeded(mine, name)
    local holders, have = 0, 0
    for _, h in pairs(mine.Holders or {}) do
        if type(h) == "table" then
            holders = holders + 1
            if h.Pickaxe == name then have = have + 1 end
        end
    end
    local owned = tonumber(mine.Pickaxes and mine.Pickaxes[name]) or 0
    return math.max(0, holders - math.max(have, owned)), have, holders
end

local pickaxeRefusedUntil = 0

--- Returns status: "bought", "done", "soldout", "poor", "refused", or nil.
local function buyBestPickaxe()
    local d = getData()
    local mine = d and d.MineGame
    if not mine then return nil end

    local best, idx = bestPickaxe(mine)
    if not best then return nil end

    local need, have, holders = pickaxesNeeded(mine, best.Name)
    if need <= 0 then return "done", best, have, holders end
    if os.clock() < pickaxeRefusedUntil then return "refused", best, have, holders end
    if pickaxeStockLeft(d, best.Name) <= 0 then return "soldout", best, have, holders end
    if (tonumber(d.Money) or 0) < (tonumber(best.Cost) or math.huge) then
        return "poor", best, have, holders
    end

    local before = tonumber(mine.Pickaxes and mine.Pickaxes[best.Name]) or 0
    GamestateEvent:FireServer("MineBuyPickaxe", idx)
    task.wait(1)

    local d2 = getData()
    local after = d2 and d2.MineGame and d2.MineGame.Pickaxes
                  and tonumber(d2.MineGame.Pickaxes[best.Name]) or before
    if after > before then
        State.PickaxesBought = State.PickaxesBought + 1
        -- The server assigns it on its own; Equip Best just hurries it along.
        GamestateEvent:FireServer("MineEquipBest")
        return "bought", best, have + 1, holders
    end

    pickaxeRefusedUntil = os.clock() + 30
    return "refused", best, have, holders
end

--- Pick and buy one upgrade, balanced:
---   * normally the cheapest affordable thing in the whole pool
---   * but while a skill node is gated on team power we don't have, the
---     Damage level with the best power-per-coin goes first
--- Confirms the level actually went up; anything the server refuses is
--- parked for REFUSE_COOLDOWN seconds so it is not spammed.
--- Returns bought, candidate, refused, pushingPower.
local function buyOne()
    local d = getData()
    local mine = d and d.MineGame
    if not mine then return false end

    local money = tonumber(d.Money) or 0
    local list, powerGoal = buyCandidates(mine)
    State.PowerGoal = powerGoal

    local c, pushing
    if powerGoal and State.UpgradeMiners and teamPower() < powerGoal then
        local bestScore
        for _, x in ipairs(list) do
            if x.power and x.power > 0 and x.cost <= money then
                local score = x.power / x.cost
                if not bestScore or score > bestScore then bestScore, c = score, x end
            end
        end
        pushing = c ~= nil
    end
    if not c then
        c = list[1]   -- sorted ascending: first is cheapest
        if not c or c.cost > money then return false end
    end

    local before = c.level(mine)
    c.fire()
    task.wait(0.8)

    local d2 = getData()
    local after = (d2 and d2.MineGame) and c.level(d2.MineGame) or before
    if after > before then
        State.Bought = State.Bought + 1
        State.Spent  = State.Spent + c.cost
        return true, c, false, pushing
    end

    State.Cooldown[c.key] = os.clock() + REFUSE_COOLDOWN
    return false, c, true, pushing
end


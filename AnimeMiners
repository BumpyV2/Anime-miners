-- ════════════════════════════════════════════════════════════════
--  GAME BINDINGS  (verified against the live client)
-- ════════════════════════════════════════════════════════════════
local GamestateEvent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GamestateEvent")
local GameState      = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameState"))

-- GetData returns a LIVE reference to the player's data table.
local function getData()
    local ok, data = pcall(GameState.GetData, lp)
    if ok and type(data) == "table" then return data end
    return nil
end

local function getMine()
    local d = getData()
    return d and d.MineGame or nil
end

-- ════════════════════════════════════════════════════════════════
--  HELPERS
-- ════════════════════════════════════════════════════════════════
local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

local function abbreviate(n)
    n = tonumber(n) or 0
    if n < 1000 then return string.format("%d", n) end
    local i = math.floor(math.log(n, 1000))
    i = math.clamp(i, 1, #SUFFIX - 1)
    return string.format("%.1f%s", n / (1000 ^ i), SUFFIX[i + 1])
end

local function countKeys(t)
    local n = 0
    if type(t) == "table" then for _ in pairs(t) do n = n + 1 end end
    return n
end

-- ════════════════════════════════════════════════════════════════
--  CORE ACTIONS
-- ════════════════════════════════════════════════════════════════

--- Pull everything sitting in the loot chest into the inventory.
--- Mirrors MineChestClient's TakeButton: only fires when the chest is non-empty.
local function takeChest()
    local mine = getMine()
    if not mine or type(mine.Chest) ~= "table" then return false, 0 end

    local items = countKeys(mine.Chest)
    if items == 0 then return false, 0 end

    GamestateEvent:FireServer("MineTakeChest")
    return true, items
end

--- Sell ores. Mirrors MineSellClient: a sorted array of entry Keys.
--- Only Kind == "Ore" is ever included, so characters, pickaxes and
--- gear are never touched.
local function sellOres(skipRarities)
    local mine = getMine()
    if not mine or type(mine.Ores) ~= "table" then return false, 0 end

    local keys = {}
    for oreName, amount in pairs(mine.Ores) do
        if (tonumber(amount) or 0) > 0 and not (skipRarities and skipRarities[oreName]) then
            table.insert(keys, oreName)
        end
    end

    if #keys == 0 then return false, 0 end
    table.sort(keys)

    GamestateEvent:FireServer("MineSellItems", keys)
    return true, #keys
end

